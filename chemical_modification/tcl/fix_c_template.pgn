# vmd -dispdev text -e fix_c.pgn
package require psfgen
topology top_all36_prot.rtf
topology top_all36_cgenff_CBD.rtf
pdbalias residue HIS HSE
pdbalias atom ILE CD1 CD

segment A {pdb qb_cp3_{{AMINO_ACID}}.pdb{{NTERM}}}
coordpdb qb_cp3_{{AMINO_ACID}}.pdb A

guesscoord
regenerate angles dihedrals
guesscoord
writepdb fix_c.pdb
writepsf fix_c.psf
exit
