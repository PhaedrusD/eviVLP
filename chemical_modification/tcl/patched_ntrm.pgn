# vmd -dispdev text -e patched_ntrm.pgn
package require psfgen
topology top_all36_cgenff_CBD.rtf

# Build segments
segment A {pdb ntrm_ref.pdb; first NONE; last NONE}
coordpdb ntrm_ref.pdb A
segment B {pdb one_aligned_ntrm.pdb}
coordpdb one_aligned_ntrm.pdb B
patch ZPP A:1 B:1


guesscoord
regenerate angles dihedrals
writepdb ntrm.pdb
writepsf ntrm.psf  

exit