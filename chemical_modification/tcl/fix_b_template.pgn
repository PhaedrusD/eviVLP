# vmd -dispdev text -e fix_b.pgn
package require psfgen
topology top_all36_prot.rtf
topology top_all36_cgenff_CBD.rtf
pdbalias residue HIS HSE
pdbalias atom ILE CD1 CD

segment A {pdb qb_cp2_{{AMINO_ACID}}.pdb{{NTERM}}}
coordpdb qb_cp2_{{AMINO_ACID}}.pdb A

guesscoord
regenerate angles dihedrals
guesscoord
writepdb fix_b.pdb
writepsf fix_b.psf
exit
